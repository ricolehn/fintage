<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin servers often run on the home network without HTTPS, and some use a certificate
     from their own authority that the user installed on the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
